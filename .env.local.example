# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. NEVER commit a file with real keys.

# === Anthropic (for the LLM categorisation + judge passes) ===
# Rotate the key paste-leaked on 2026-05-18 before using.
#ANTHROPIC_API_KEY=sk-ant-...
NVIDIA_API_KEY=nvapi-
# === MySQL: read-only access to release4_rma (the live RMA DB) ===
RMA_DB_HOST=mum-db-rma.ct2cw0yswug5.ap-south-1.rds.amazonaws.com
RMA_DB_USER=ranita
RMA_DB_PASS=
RMA_DB_NAME=release4_rma

# === MySQL: write access to release4_rma (for raising tickets) ===
RMA_WRITE_DB_HOST=mum-db-rma.ct2cw0yswug5.ap-south-1.rds.amazonaws.com
RMA_WRITE_DB_USER=upal
RMA_WRITE_DB_PASS=
RMA_WRITE_DB_NAME=release4_rma

# === MySQL: read/write access to rma_ai (our new editorial-checker DB) ===
# `ranita` has confirmed write access; no separate user needed unless you want stricter scoping.
RMA_AI_DB_HOST=mum-db-rma.ct2cw0yswug5.ap-south-1.rds.amazonaws.com
RMA_AI_DB_USER=ranita
RMA_AI_DB_PASS=
RMA_AI_DB_NAME=rma_ai

# === Python scripts (extract_starter_rules.py, apply_migration.py) read these aliases ===
# They duplicate the values above. Keeping both because Python and Node scripts
# use different historical naming. Set them to the same values.
RMA_HOST=mum-db-rma.ct2cw0yswug5.ap-south-1.rds.amazonaws.com
RMA_USER=ranita
RMA_PASS=
RMA_AI_HOST=mum-db-rma.ct2cw0yswug5.ap-south-1.rds.amazonaws.com
RMA_AI_USER=ranita
RMA_AI_PASS=

# === App ===
NEXT_PUBLIC_APP_NAME=RMA Editorial Checker
NODE_ENV=development

# === Admin auth (Phase A — simple shared password, later integrate with RMA admin) ===
ADMIN_PASSWORD=
